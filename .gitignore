node_modules

# Environment variables (contains sensitive credentials)
.env
.env.*
!.env.example

# Server environment files
server/.env
server/.env.*
!server/.env.example

# Client environment files  
client/.env
client/.env.*
!client/.env.example

# User-uploaded files. These are runtime data, not source — two resumes had
# been committed by accident. The directory itself is kept so the app has
# somewhere to write on a fresh checkout.
server/uploads/*
!server/uploads/.gitkeep
