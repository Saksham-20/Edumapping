# Every environment variable the API reads (grep "process.env" server/src).
# Copy to server/.env and fill in. Values here are placeholders, never real
# secrets. Anything commented out has a working default.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | production | test. Development runs sequelize.sync({alter}),
# relaxes rate limits for localhost and logs dev-only OTPs (see below).
NODE_ENV=development
PORT=5000
# LOG_LEVEL=DEBUG            # ERROR | WARN | INFO | DEBUG (default: INFO in production, DEBUG otherwise)
# API_TIMEOUT_MS=25000       # per-request timeout before a 504
# API_PUBLIC_URL=            # base URL shown in Swagger (/api-docs)
# SERVE_CLIENT=true          # production: also serve client/build from Express ("false" when nginx does it)

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=edumapping_dev
DB_HOST=localhost
DB_PORT=5432
# Production alternative to the DB_* variables (DB_* win when both are set).
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Force SSL to Postgres (always on in production with DATABASE_URL).
# DATABASE_SSL=false
# PGSSLMODE=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate each with: openssl rand -base64 48   (must differ from each other)
JWT_SECRET=replace_with_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_secret
# JWT_EXPIRE=1h
# JWT_REFRESH_EXPIRE=7d
# BCRYPT_ROUNDS=12           # 10-12 recommended

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Exact browser origins allowed to call the API, comma-separated. In
# production https://edumapping.com and its subdomains are always allowed; in
# development any localhost / 127.0.0.1 port is.
FRONTEND_URL=http://localhost:3000
# CLIENT_URL=                # accepted as an alias of FRONTEND_URL

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# When SMTP_HOST is set, registration REQUIRES the emailed 6-digit code
# (GET /api/auth/config reports emailVerificationRequired: true and the signup
# screens ask for it). When it is unset, signup proceeds without a code and the
# approval queue is the only check on staff/recruiter accounts; in development
# the code is written to the server log instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false            # true for port 465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@edumapping.com

# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
# OTP_EXPIRY_MINUTES=10
# OTP_RATE_LIMIT_MAX=5          # send-otp requests per IP per 15 min
# OTP_VERIFY_RATE_LIMIT_MAX=10  # register / reset-with-otp attempts per IP+email per 15 min
# Each code is also burned after 5 wrong guesses.

# Standing code accepted instead of an emailed registration OTP.
# TEMPORARY BRIDGE for when SMTP is not configured — with this set, anyone can
# register an address they do not own. Registration only; it is refused for
# password reset. Every use is logged at WARN. Unset it once SMTP works.
OTP_BYPASS_CODE=

# BULK_IMPORT_DEFAULT_PASSWORD is NO LONGER READ. Bulk-imported students each
# get a random temporary password, returned once in the import result (the
# admin screen offers it as a CSV). Remove the variable from existing .env files.

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
# RATE_LIMIT_MAX_REQUESTS=500      # per user (verified JWT) or IP per window; default 500 prod / 1000 dev
# CONTACT_RATE_LIMIT_MAX=5         # POST /api/contact per IP per hour
# ANNOUNCE_RATE_LIMIT_MAX=10       # announcement broadcasts per sender per window (routes/notifications.js)

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# local (server/uploads) or minio. Only profile pictures and logos are served
# publicly from /uploads; resumes, marksheets, offer letters and documents are
# served only through the authenticated GET /api/files/serve.
STORAGE_TYPE=local
# MAX_FILE_SIZE=10485760           # bytes
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=replace_me
# MINIO_SECRET_KEY=replace_me
# MINIO_BUCKET=edumapping

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# REMINDER_SWEEP_MINUTES=15        # deadline-reminder sweep interval; 0 disables

# ---------------------------------------------------------------------------
# Live classes (LiveKit SFU)
# ---------------------------------------------------------------------------
# Leave these blank to disable conferencing entirely — the /api/conferences
# endpoints then return 503 and the rest of the API is unaffected.
#
# LIVEKIT_URL        Server-to-server address the API uses for admin calls.
#                    Loopback, because livekit-server binds to 127.0.0.1.
# LIVEKIT_PUBLIC_URL wss:// address handed to browsers, proxied by nginx.
# The key/secret are generated by deploy/livekit/install-livekit.sh and
# stored in /etc/livekit/keys.env on the server.
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=wss://edumapping.com/livekit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# How long a join token stays valid. Kicked users are blocked by the database
# check in the token endpoint, not by this expiry.
LIVEKIT_TOKEN_TTL=3h

# ---------------------------------------------------------------- AI assistant
# "Ask EduMapping" placement assistant (Claude API). Leave unset to hide it —
# /api/assistant/* then answers 503 and the client shows no assistant button.
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-5-5.
ASSISTANT_MODEL=
