# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=edumapping_dev
DB_HOST=localhost
DB_PORT=5432

# Node Environment (development/production)
NODE_ENV=development

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

# Server Configuration
PORT=5000

# Optional: Bcrypt rounds (10-12 recommended)
BCRYPT_ROUNDS=10

# Rate Limiting Configuration
# RATE_LIMIT_WINDOW_MS=900000 (15 minutes in milliseconds)
# RATE_LIMIT_MAX_REQUESTS=1000 (for development, 500 for production)

# ---------------------------------------------------------------------------
# Live classes (LiveKit SFU)
# ---------------------------------------------------------------------------
# Leave these blank to disable conferencing entirely — the /api/conferences
# endpoints then return 503 and the rest of the API is unaffected.
#
# LIVEKIT_URL        Server-to-server address the API uses for admin calls.
#                    Loopback, because livekit-server binds to 127.0.0.1.
# LIVEKIT_PUBLIC_URL wss:// address handed to browsers, proxied by nginx.
# The key/secret are generated by deploy/livekit/install-livekit.sh and
# stored in /etc/livekit/keys.env on the server.
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=wss://edumapping.com/livekit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# How long a join token stays valid. Kicked users are blocked by the database
# check in the token endpoint, not by this expiry.
LIVEKIT_TOKEN_TTL=3h

# Standing code accepted instead of an emailed registration OTP.
# TEMPORARY BRIDGE for when SMTP is not configured — with this set, anyone can
# register an address they do not own. Registration only; it is refused for
# password reset. Every use is logged at WARN. Unset it once SMTP works.
OTP_BYPASS_CODE=
